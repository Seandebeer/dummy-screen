{
  "name": "Command",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "default": "stage-1"
    },
    "type": {
      "type": "string",
      "enum": [
        "call_incoming",
        "call_outgoing",
        "call_answered",
        "call_end",
        "alarm"
      ]
    },
    "contact_name": {
      "type": "string"
    },
    "contact_number": {
      "type": "string"
    },
    "contact_image": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "completed"
      ],
      "default": "pending"
    }
  },
  "required": [
    "type"
  ]
}