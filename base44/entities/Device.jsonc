{
  "name": "Device",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "phone",
        "tablet",
        "screen",
        "remote"
      ],
      "default": "phone"
    },
    "status": {
      "type": "string",
      "enum": [
        "online",
        "offline"
      ],
      "default": "offline"
    },
    "project_id": {
      "type": "string"
    },
    "config": {
      "type": "string"
    },
    "make": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "colour": {
      "type": "string"
    },
    "serial": {
      "type": "string"
    },
    "photo": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}