{
  "name": "Message",
  "type": "object",
  "properties": {
    "thread_id": {
      "type": "string",
      "default": "stage-1"
    },
    "sender": {
      "type": "string",
      "enum": [
        "control",
        "phone"
      ]
    },
    "text": {
      "type": "string"
    },
    "sender_name": {
      "type": "string",
      "default": "Control"
    },
    "contact_image": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "Screen id of the browser that pushed this message, so the pushing screen never reacts to it"
    }
  },
  "required": [
    "sender",
    "text"
  ]
}